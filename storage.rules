rules_version = '2';

// Loop — see docs/11-firebase.md#security-rules.
//
// Two prefixes, both owner-only, both size- and type-capped: category logos
// (docs/04-categories.md, Phase 2) and expense receipts (docs/03-expenses.md,
// a later phase — the rule is written now so a receipt-upload feature never
// has to touch this file). Everything else is denied.

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isSizedImage(maxBytes) {
      return request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/categoryLogos/{categoryId} {
      allow read: if isOwner(uid);
      // 512_000 — the same ceiling packages/shared/src/categories.ts checks
      // client-side, so a rejection here should never be the first time a user
      // hears about the limit.
      allow write: if isOwner(uid) && isSizedImage(512000);
    }

    match /users/{uid}/receipts/{expenseId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isSizedImage(5 * 1024 * 1024);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
