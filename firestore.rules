rules_version = '2';

// Loop — see docs/11-firebase.md.
//
// The trust boundary in one sentence: a user may write their own expenses,
// categories, settings and check-ins; they may NOT write anything that could be
// inflated for gain. Coins, the wallet and every rollup are written only by
// Cloud Functions, which bypass these rules.
//
// These rules are code and are tested like code. Do not edit them without
// updating the emulator suite that covers them.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isLocalDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // The category catalogue is shipped, not user-generated.
    match /catalog/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      // Account deletion goes through a Function that clears the whole subtree.
      allow delete: if false;

      match /settings/{doc} {
        allow read, write: if isOwner(uid);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(uid);
        // `request.resource` is null on delete, so validating its fields has to
        // stay out of that branch — folding delete into one `allow write` throws
        // a null-value error and denies every delete, not just malformed ones.
        allow create, update: if isOwner(uid)
          && request.resource.data.slug is string
          && request.resource.data.slug.size() <= 12;
        allow delete: if isOwner(uid);
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(uid);

        // A float or a negative amount reaching Firestore is a corruption that
        // survives every client-side fix, so it is rejected here as well.
        allow create, update: if isOwner(uid)
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor > 0
          && request.resource.data.currency is string
          && isLocalDate(request.resource.data.localDate)
          && (!('createdLocalDate' in request.resource.data)
              || request.resource.data.createdLocalDate == null
              || isLocalDate(request.resource.data.createdLocalDate))
          && request.resource.data.categoryId is string
          // Kind validation: clients may write kind only in expense | income | refund | transfer
          && (!('kind' in request.resource.data)
              || request.resource.data.kind == null
              || request.resource.data.kind in ['expense', 'income', 'refund', 'transfer'])
          // Transfer validation: if kind is transfer, then toAccountId must differ from accountId
          && (!('kind' in request.resource.data)
              || request.resource.data.kind == null
              || request.resource.data.kind != 'transfer'
              || (request.resource.data.toAccountId is string
                  && request.resource.data.accountId is string
                  && request.resource.data.toAccountId != request.resource.data.accountId))
          // Optional new fields are type-checked when present
          && (!('accountId' in request.resource.data) || request.resource.data.accountId is string || request.resource.data.accountId == null)
          && (!('toAccountId' in request.resource.data) || request.resource.data.toAccountId is string || request.resource.data.toAccountId == null)
          && (!('refundOf' in request.resource.data) || request.resource.data.refundOf is string || request.resource.data.refundOf == null)
          && (!('merchant' in request.resource.data) || request.resource.data.merchant is string || request.resource.data.merchant == null)
          && (!('merchantKey' in request.resource.data) || request.resource.data.merchantKey is string || request.resource.data.merchantKey == null)
          && (!('tagIds' in request.resource.data) || request.resource.data.tagIds is list || request.resource.data.tagIds == null)
          && (!('lines' in request.resource.data) || request.resource.data.lines is list || request.resource.data.lines == null)
          && (!('categoryIds' in request.resource.data) || request.resource.data.categoryIds is list || request.resource.data.categoryIds == null)
          && (!('recurringId' in request.resource.data) || request.resource.data.recurringId is string || request.resource.data.recurringId == null)
          && (!('importId' in request.resource.data) || request.resource.data.importId is string || request.resource.data.importId == null)
          // rollupApplied and meta/schema are owner-readable and client-unwritable
          && !('rollupApplied' in request.resource.data)
          && !('meta' in request.resource.data)
          && !('schema' in request.resource.data);

        // Deletion is soft — an update setting deletedAt. Hard deletes are a
        // scheduled Function's job.
        allow delete: if false;
      }

      // Accounts (docs/18-accounts.md § Data and rules). Mirrors
      // validateAccountDraft in accounts.ts, so the form and the rules agree.
      // Rules can't count transactions, so "delete only with zero
      // transactions" is the client's check; archive is the normal path.
      match /accounts/{accountId} {
        function validAccount(d) {
          return d.name is string && d.name.size() > 0 && d.name.size() <= 24
            && d.type in ['cash', 'bank', 'card', 'wallet']
            && (d.last4 == null || (d.last4 is string && d.last4.matches('^[0-9]{4}$')))
            && d.openingBalance is map
            && d.openingBalance.amountMinor is int
            && d.openingBalance.currency is string
            && isLocalDate(d.openingDate)
            && d.sortOrder is int && d.sortOrder >= 0;
        }

        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAccount(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // SMS-derived proposals (docs/12-sms-ingest.md). Never an expense until
      // approved, never deleted by a client (rejections are the post-MVP
      // training signal), and never carrying the raw message: the key set is
      // exact, so a `body` field is refused outright.
      match /pendingExpenses/{pendingId} {
        function pendingKeys() {
          return ['status', 'amountMinor', 'currency', 'merchant', 'accountLast4',
                  'occurredAt', 'receivedAt', 'source', 'templateId', 'confidence',
                  'suggestedCategoryId', 'suggestionConfidence', 'suggestionModelVersion',
                  'expenseId', 'displayHint', 'createdAt', 'updatedAt'];
        }

        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(pendingKeys())
          && request.resource.data.keys().hasAll(pendingKeys())
          && request.resource.data.status == 'pending'
          && request.resource.data.expenseId == null
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor > 0
          && request.resource.data.currency is string
          && request.resource.data.source in ['sms', 'shared', 'pasted'];

        // Only a decision on a pending item. The amount, currency and dates are
        // what the bank said and cannot be rewritten; approval must create the
        // linked expense in the same batch (P4's approve writes both).
        allow update: if isOwner(uid)
          && resource.data.status == 'pending'
          && (
            (request.resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expenseId', 'updatedAt'])
              && request.resource.data.expenseId is string
              && existsAfter(/databases/$(database)/documents/users/$(uid)/expenses/$(request.resource.data.expenseId)))
            || (request.resource.data.status == 'rejected'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          );

        allow delete: if false;
      }

      // The document id IS the local date, which is what makes a check-in
      // idempotent. Create-only: an editable check-in is a rewritable streak.
      match /checkIns/{localDate} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isLocalDate(localDate);
        allow update, delete: if false;
      }

      // Everything below is server-authoritative. Clients read, never write.
      match /streak/{doc}         { allow read: if isOwner(uid); allow write: if false; }
      match /wallet/{doc}         { allow read: if isOwner(uid); allow write: if false; }
      match /coinLedger/{entryId} { allow read: if isOwner(uid); allow write: if false; }
      match /dailyRollups/{date}  { allow read: if isOwner(uid); allow write: if false; }
      match /monthlyRollups/{m}   { allow read: if isOwner(uid); allow write: if false; }
      // v1.2: the account flows and the per-document marker the client needs for
      // an exact offline balance (docs/18 § The balance). Functions write both.
      match /accountBalances/{accountId} { allow read: if isOwner(uid); allow write: if false; }
      match /rollupApplied/{expenseId}   { allow read: if isOwner(uid); allow write: if false; }
      // meta/schema: written only by scripts/migrate-v2.ts. Clients never
      // decide that a migration ran (docs/27 § Migration script).
      match /meta/{docId}                { allow read: if isOwner(uid); allow write: if false; }

      match /groupIndex/{groupId} { allow read: if isOwner(uid); allow write: if isOwner(uid); }
      match /devices/{deviceId}   { allow read, write: if isOwner(uid); }
    }

    // Groups — v1.1. Defined now so the shape is fixed and testable; no client
    // writes groups in v1.
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;

      match /balances/{uid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow write: if false;
      }
    }

    // Anything not matched above is denied. Keep it that way.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
