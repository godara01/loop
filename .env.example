# Copy to .env and fill in. Never commit .env.
#
# Firebase app config does NOT live here — it ships as google-services.json /
# GoogleService-Info.plist under apps/mobile/firebase/ (gitignored, and uploaded
# to EAS as file secrets). See apps/mobile/firebase/README.md.

# Which Firebase project a build talks to: dev | staging | prod
EXPO_PUBLIC_FIREBASE_ENV=dev

# Point the app at the local Firebase Emulator Suite instead of a real project.
# Leave false in any build you hand to someone else.
EXPO_PUBLIC_USE_EMULATORS=false

# The emulator host as seen FROM THE DEVICE. localhost is the phone itself, so a
# physical device needs your machine's LAN IP; an Android emulator needs 10.0.2.2.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
