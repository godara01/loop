# Copy to apps/mobile/.env. Expo reads env files from the app's own folder, and
# inlines EXPO_PUBLIC_* at bundle time — restart Metro after changing this.
#
# Firebase app config does NOT live here: it ships as google-services.json /
# GoogleService-Info.plist under apps/mobile/firebase/. See docs/14.

# Talk to the local Firebase Emulator Suite (`npm run firebase:emulators`)
# instead of the real project. EAS builds have no .env, so they always use live.
EXPO_PUBLIC_USE_EMULATORS=true

# The emulator host as seen FROM THE DEVICE. `localhost` works on the Android
# emulator (RNFirebase rewrites it to 10.0.2.2). A physical phone needs this
# machine's LAN IP.
EXPO_PUBLIC_EMULATOR_HOST=localhost
