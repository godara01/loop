{
  "name": "loop",
  "private": true,
  "version": "0.1.0",
  "description": "Loop — gamified, haptic expense tracking and group settlement",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "npm run start --workspace=@loop/mobile",
    "mobile:android": "npm run android --workspace=@loop/mobile",
    "mobile:ios": "npm run ios --workspace=@loop/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mobile:tunnel": "npm run start:tunnel --workspace=@loop/mobile",
    "emulator": "bash scripts/emulator.sh",
    "test:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project demo-loop \"tsx --test tests/firestore-rules/*.test.ts tests/storage-rules/*.test.ts\"",
    "firebase:emulators": "bash scripts/firebase-emulators.sh",
    "e2e": "bash scripts/e2e.sh",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/seed-emulator.ts",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:testids": "node scripts/check-testids.mjs",
    "test:perf": "bash scripts/perf-ledger.sh",
    "test:functions": "firebase emulators:exec --config firebase.rules-test.json --only firestore --project demo-loop \"tsx --test tests/functions/*.test.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "firebase-functions": "^7.4.0"
  }
}
