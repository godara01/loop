{
  "name": "@loop/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --outfile=lib/index.js --external:firebase-admin --external:firebase-functions",
    "build:watch": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@loop/shared": "*",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "22"
  }
}
