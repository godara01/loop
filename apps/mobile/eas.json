  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_FIREBASE_ENV": "dev",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "786081644010-nm45jstdl4toravsg3f8lhv4s93rvr96.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "786081644010-nm45jstdl4toravsg3f8lhv4s93rvr96.apps.googleusercontent.com"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "786081644010-nm45jstdl4toravsg3f8lhv4s93rvr96.apps.googleusercontent.com"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
